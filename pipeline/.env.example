# Copy to .env and fill in. Never commit .env anywhere.

# --- LLM via your z.ai coding-plan subscription (no per-token billing) ---
LLM_BASE_URL=https://api.z.ai/api/anthropic
LLM_API_KEY=your-zai-token-here
LLM_MODEL=glm-5.2

# --- Breakout notifications (optional) ---
# Any webhook that accepts {"text": "..."} — e.g. your Cyndra Agent inbound
# hook so alerts land in WhatsApp.
# REELS_WEBHOOK_URL=

# --- Later: HeyGen API mode (pay-as-you-go credits) ---
# HEYGEN_API_KEY=
# HEYGEN_AVATAR_ID=        # from GET /v2/avatars — CLAUDE.md Stage 1 walks you through it
# HEYGEN_VOICE_ID=         # from GET /v2/voices — confirm it's YOUR clone's voice

# --- Optional overrides (defaults work; set only if you need to) ---
# WHISPER_MODEL=           # path to ggml-small.en.bin (auto-downloads to pipeline/models/ if unset)
# REELS_BROWSER=           # browser binary for Remotion renders (flaky Linux servers)
# SCREENSHOT_BROWSER=      # browser binary for screenshot.py captures
# REELS_EPISODES_DIR=      # episodes live here instead of ./episodes (containers use /data/episodes)
# REELS_LOCAL_CONFIG=      # explicit path to config.local.json (see configlib.py fallbacks)
# TOPIC_HOUR=6             # daily topic video hour (worker schedule)
# DAILY_HOUR=13            # daily repo-radar hour
# WATCH_EVERY_HOURS=2      # breakout watcher cadence
# DASH_PASSWORD=           # basic-auth password for the serve.py dashboard (unset = token-URL only)

# --- Metricool posting ---
# METRICOOL_USER_TOKEN=
# METRICOOL_USER_ID=
# METRICOOL_BLOG_ID=
# METRICOOL_PROVIDERS=tiktok,instagram,youtube,linkedin
# TIMEZONE=Asia/Bangkok

# --- Public media URL for Metricool to fetch finals (serve.py or nginx) ---
# REELS_PUBLIC_BASE=https://your-server:8737/<REELS_SERVE_TOKEN>
# REELS_SERVE_TOKEN=some-long-random-string
# REELS_SERVE_PORT=8737

# --- Telegram delivery (QA-passed finals + alerts to your phone) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
